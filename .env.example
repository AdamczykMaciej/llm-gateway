# ── Provider credentials (at least one required) ─────────────────────────────
ANTHROPIC_API_KEY=
GROQ_API_KEY=
OPENAI_API_KEY=

# ── Provider models (optional overrides) ──────────────────────────────────────
# CLAUDE_MODEL=claude-haiku-4-5-20251001
# GROQ_MODEL=llama-3.3-70b-versatile
# OPENAI_MODEL=gpt-4o-mini

# ── Routing ────────────────────────────────────────────────────────────────────
# PROVIDER_ORDER=anthropic,groq,openai
# BREAKER_FAILURE_THRESHOLD=3
# BREAKER_COOLDOWN_SECONDS=60

# ── Tracing (optional) ─────────────────────────────────────────────────────────
# TRACE_INCLUDE_PROMPTS=false
# OTEL_EXPORTER_OTLP_ENDPOINT=
# OTEL_EXPORTER_OTLP_HEADERS=

# ── HTTP service auth — set before deploying, unset = open/no auth ────────────
GATEWAY_API_KEYS=replace-with-a-long-random-gateway-key

PORT=8080
