# ── Provider credentials (at least one required) ─────────────────────────────
ANTHROPIC_API_KEY=
GROQ_API_KEY=
OPENAI_API_KEY=

# ── Azure AI Foundry / Azure OpenAI v1 (optional; see README) ────────────────
# AZURE_ENDPOINT=https://<resource>.services.ai.azure.com
# AZURE_MODEL=<deployment-name>
# AZURE_AUTH=entra              # or api_key
# AZURE_API_KEY=                # only for AZURE_AUTH=api_key
# AZURE_MANAGED_IDENTITY_CLIENT_ID=
# AZURE_REASONING_EFFORT=low    # "" for non-reasoning deployments

# ── Provider models (optional overrides) ──────────────────────────────────────
# CLAUDE_MODEL=claude-haiku-4-5-20251001
# GROQ_MODEL=openai/gpt-oss-120b
# OPENAI_MODEL=gpt-4o-mini

# ── Routing ────────────────────────────────────────────────────────────────────
# PROVIDER_ORDER=anthropic,groq,openai
# BREAKER_FAILURE_THRESHOLD=3
# BREAKER_COOLDOWN_SECONDS=60
# RETRY_ATTEMPTS=2
# RETRY_BASE_DELAY_SECONDS=0.2
# REQUEST_TIMEOUT_SECONDS=45
# STREAM_IDLE_TIMEOUT_SECONDS=30
# SDK_MAX_RETRIES=0
# CALL_DEADLINE_SECONDS=90

# ── Tracing (optional) ─────────────────────────────────────────────────────────
# TRACE_INCLUDE_PROMPTS=false
# OTEL_EXPORTER_OTLP_ENDPOINT=
# OTEL_EXPORTER_OTLP_HEADERS=

# ── HTTP service auth — set before deploying, unset = open/no auth ────────────
GATEWAY_API_KEYS=replace-with-a-long-random-gateway-key

PORT=8080
