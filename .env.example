# ── Provider credentials (at least one required) ─────────────────────────────
ANTHROPIC_API_KEY=
GROQ_API_KEY=
OPENAI_API_KEY=

# ── Azure AI Foundry / Azure OpenAI v1 (optional; see README) ────────────────
# AZURE_ENDPOINT=https://<resource>.services.ai.azure.com
# AZURE_MODEL=<deployment-name>
# AZURE_AUTH=entra              # or api_key
# AZURE_API_KEY=                # only for AZURE_AUTH=api_key
# AZURE_MANAGED_IDENTITY_CLIENT_ID=
# AZURE_REASONING_EFFORT=low    # "" for non-reasoning deployments
# AZURE_MAX_TOKENS_PARAM=max_completion_tokens  # or max_tokens if the deployment rejects it

# ── Claude on Google Vertex AI (optional; pip install 'llm-gateway[vertex]'; see README) ──
# VERTEX_PROJECT_ID=my-vertex-project
# VERTEX_LOCATION=europe-west1               # Haiku 4.5: europe-west1 (EU processing), us-east5 or global
# VERTEX_MODEL=claude-haiku-4-5@20251001
# VERTEX_CREDENTIALS_FILE=                   # external_account (WIF) config, no key; unset = ADC
# VERTEX_IMPERSONATE_SERVICE_ACCOUNT=
# VERTEX_AZURE_APP_ID_URI=                   # WIF from an Azure managed identity (also needs [azure])
# VERTEX_AZURE_MANAGED_IDENTITY_CLIENT_ID=

# ── Provider models (optional overrides) ──────────────────────────────────────
# CLAUDE_MODEL=claude-haiku-4-5-20251001
# GROQ_MODEL=openai/gpt-oss-120b
# OPENAI_MODEL=gpt-4o-mini

# ── Routing ────────────────────────────────────────────────────────────────────
# PROVIDER_ORDER=anthropic,groq,openai
# BREAKER_FAILURE_THRESHOLD=3
# BREAKER_COOLDOWN_SECONDS=60
# RETRY_ATTEMPTS=2
# RETRY_BASE_DELAY_SECONDS=0.2
# REQUEST_TIMEOUT_SECONDS=45
# STREAM_IDLE_TIMEOUT_SECONDS=30
# SDK_MAX_RETRIES=0
# CALL_DEADLINE_SECONDS=90

# ── Tracing (optional) ─────────────────────────────────────────────────────────
# TRACE_INCLUDE_PROMPTS=false
# OTEL_EXPORTER_OTLP_ENDPOINT=
# OTEL_EXPORTER_OTLP_HEADERS=

# ── HTTP service auth — set before deploying, unset = open/no auth ────────────
GATEWAY_API_KEYS=replace-with-a-long-random-gateway-key

PORT=8080

# ── Provider policy and cost controls (optional; see README) ──────────────────
# Operator-asserted facts only — the library never asserts them for a vendor.
# PROVIDER_METADATA={"azure": {"region": "eu", "retention": "abuse_monitoring_30d", "trains_on_data": false, "dpa": true}}
# POLICY_RESIDENCY=eu
# POLICY_REQUIRE_ZERO_RETENTION=false
# POLICY_FORBID_TRAINING=false
# POLICY_REQUIRE_DPA=false
# POLICY_ONLY=
# POLICY_IGNORE=
# POLICY_REQUIRE_PARAMETERS=false
# POLICY_MAX_COST_USD=0
# POLICY_SORT=order
# MODEL_PRICES={"groq/openai/gpt-oss-120b": {"input_per_mtok": 0.15, "output_per_mtok": 0.6}}
