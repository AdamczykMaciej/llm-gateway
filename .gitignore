.env
.venv/
.pytest_cache/
.ruff_cache/
__pycache__/
*.py[cod]
build/
dist/
*.egg-info/

# Terraform (the .terraform.lock.hcl provider lock file IS committed —
# that's what pins reproducible provider versions across machines/CI)
infra/terraform/.terraform/
infra/terraform/*.tfstate
infra/terraform/*.tfstate.*
infra/terraform/terraform.tfvars
# Plaintext SOPS source — only secrets.enc.yaml (ciphertext) is committed
infra/terraform/secrets.yaml
