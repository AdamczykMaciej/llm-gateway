# Copy to secrets.yaml, fill in real values, then encrypt it:
#
#   cp secrets.yaml.example secrets.yaml
#   $EDITOR secrets.yaml          # fill in real values
#   sops -e secrets.yaml > secrets.enc.yaml
#   rm secrets.yaml               # don't leave the plaintext lying around
#
# secrets.enc.yaml is safe to commit — it's ciphertext, decryptable only by
# whoever has roles/cloudkms.cryptoKeyEncrypterDecrypter on the KMS key in
# .sops.yaml (you, and the CI service account — see kms.tf).
#
# To edit later: `sops secrets.enc.yaml` opens it decrypted in $EDITOR and
# re-encrypts on save. Never hand-edit secrets.enc.yaml directly.
#
# All four are optional — leave blank to skip a provider or leave the
# gateway open (unauthenticated). At least one provider key is needed for
# the gateway to actually complete a request.

anthropic_api_key: ""
groq_api_key: ""
openai_api_key: ""
gateway_api_keys: ""
